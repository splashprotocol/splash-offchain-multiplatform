# Optional overrides for run-amm-limit-auction-flow.sh. The auditor wrapper can run
# without a .env by using this file as defaults and prompting for missing
# machine-local values.
NETWORK=preprod
SUBMIT=1

# API provider used by Lucid scripts.
PROVIDER=blockfrost
BLOCKFROST_PROJECT_ID=
MAESTRO_API_KEY=

# Wallet seed file for lower-level scripts. The auditor wrapper overrides this
# with a fresh .run/wallets/<run-id>.seed file on every start.
WALLET_SEED_FILE=testing/preprod/amm-limit-auction-flow/wallet.seed

# One-shot setup inputs. The auditor wrapper defaults to fresh setup with the
# already deployed auction validator reference script, then mints a unique token
# pair for each run.
AUDITOR_FRESH_SETUP=1

# Agent inputs.
NODE_SOCKET=
OPERATOR_KEY_CBOR_HEX=
AGENT_BIN=target/debug/bloom-cardano-agent
AGENT_HEALTH_ADDR=127.0.0.1:9024
AGENT_READY_TIMEOUT_SECS=180
BUILD_AGENT=1
AGENT_DISABLE_MEMPOOL=1
AGENT_FUNDING_LOVELACE=50000000
# Leave empty to require the auditor default, 500 tADA. Override only when
# running with a deliberately different funding budget.
REQUIRED_WALLET_LOVELACE=

# Existing deployment/config files.
BASE_AGENT_CONFIG=bloom-cardano-agent/resources/preprod.config.json
DEPLOYMENT_CONFIG=bloom-cardano-agent/resources/preprod.deployment.json
VALIDATION_RULES=bloom-cardano-agent/resources/validation-rules.json.template
# Optional override. Leave empty to use the harness run-local stdout log config.
LOG4RS_CONFIG=

# Auction validator reference script.
AUCTION_VALIDATOR_HASH=fbc59e20bd55b1b521db154643fb359020bdfc8da40120946c89c08a
AUCTION_VALIDATOR_REF_TX_HASH=7eccade32a21891469792da9b9ecbd9f0fed9835a591a109e63f6889d2118cf0
AUCTION_VALIDATOR_REF_OUTPUT_INDEX=0
AUCTION_VALIDATOR_COST_MEM=500000
AUCTION_VALIDATOR_COST_STEPS=160000000
AUCTION_VALIDATOR_MARGINAL_COST_MEM=0
AUCTION_VALIDATOR_MARGINAL_COST_STEPS=0
AUCTION_MAX_COST_PER_EX_STEP=500000
AUCTION_MIN_MARGINAL_OUTPUT=1

# Token-token auction config. Empty policy means ADA and is rejected by preflight.
AUCTION_BASE_POLICY=
AUCTION_BASE_NAME_HEX=
AUCTION_QUOTE_POLICY=
AUCTION_QUOTE_NAME_HEX=
AUCTION_BASE_AMOUNT=
AUCTION_PRICE_START_NUM=
AUCTION_PRICE_START_DENOM=
AUCTION_START_TIME_POSIX=
AUCTION_STEP_LEN_SECS=600
AUCTION_STEPS=10
AUCTION_PRICE_DECAY_NUM=1000
AUCTION_FEE_PER_QUOTE_NUM=0
AUCTION_FEE_PER_QUOTE_DENOM=1
AUCTION_LOVELACE_BUDGET=3000000

# Optional: run against an already-created auction instead of creating one.
EXISTING_AUCTION_TX_HASH=
EXISTING_AUCTION_OUTPUT_INDEX=

# Expected result polling.
VERIFY_TIMEOUT_SECS=900
VERIFY_POLL_SECS=10

# Exact-liquidity preflight. Preprod flow creates/uses a paired limit order at
# the active auction price. Pool matching is intentionally not used by this harness.
TARGET_LIQUIDITY_MODE=counterOrder
TARGET_COUNTER_ORDER_PRICE_NUM=
TARGET_COUNTER_ORDER_PRICE_DENOM=
TARGET_COUNTER_ORDER_TX_HASH=
TARGET_COUNTER_ORDER_OUTPUT_INDEX=

# Optional: create a paired limit order during submit flow.
CREATE_COUNTER_ORDER=1
COUNTER_ORDER_LOVELACE_BUDGET=3000000
COUNTER_ORDER_FEE=500000

# Require enough time left in the selected auction span for submit/index/match.
MIN_SPAN_REMAINING_SECS=120
